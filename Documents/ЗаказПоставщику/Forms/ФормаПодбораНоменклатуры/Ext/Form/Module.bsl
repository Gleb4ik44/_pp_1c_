
&НаКлиенте
Процедура Отменить(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	СтруктураВозврата = Новый Структура;
	
	МассивЗначений = Новый Массив;
	
	ЗаполнитьСтруктуруВозвратаНаСервере();
	
	Для Каждого Стр Из ПеремещаемаяНоменклатура Цикл
		
		МассивЗначений.Добавить(Стр.Номенклатура);
		
	КонецЦикла;
	
	СтруктураВозврата.Вставить("СписокНоменклатуры", МассивЗначений);
	
	Закрыть(СтруктураВозврата);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокИнструментовНаСкладеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЭлементВыбора = Элемент.ТекущиеДанные.Номенклатура; 
	
	Элемент.ТекущиеДанные.Выбран = Истина;
	
	ЭлементВыбран = Ложь;
	
	Для Каждого Стр Из ПеремещаемаяНоменклатура Цикл
		
		Если Стр.Номенклатура = ЭлементВыбора Тогда
			ЭлементВыбран = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЭлементВыбран Тогда
		СтрокаДоб = ПеремещаемаяНоменклатура.Добавить();
		СтрокаДоб.Номенклатура = ЭлементВыбора;
	Иначе 
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Элемент уже выбран!";
		Сообщение.Сообщить();
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьТЧПоСкладу();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	НовоеУсловноеОформление = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();
	НовоеУсловноеОформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0, 150, 70));
	
	ОтборЭлемента = НовоеУсловноеОформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокИнструментовНаСкладе.Выбран");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина; 
		
	ПолеЭлемента = НовоеУсловноеОформление.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("СписокИнструментовНаСкладе");	
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьТЧПоСкладу()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
		|	ЛОЖЬ КАК Выбрать,
		|	НЕОПРЕДЕЛЕНО КАК Картинка
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
		|	ВТ_Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
		|	ВТ_Номенклатура.Выбрать КАК Выбрать,
		|	ВТ_Номенклатура.Картинка КАК Картинка,
		|	ЕСТЬNULL(ОстаткиНоменклатурыОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ОстаткиНоменклатурыОстатки.КоличествоОстаток, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ОстаткиНоменклатурыОстатки.СуммаОстаток, 0) / ЕСТЬNULL(ОстаткиНоменклатурыОстатки.КоличествоОстаток, 0)
		|	КОНЕЦ КАК Себестоимость,
		|	ВТ_Номенклатура.Номенклатура.ЭтоГруппа КАК ЭтоГруппа
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиНоменклатуры.Остатки КАК ОстаткиНоменклатурыОстатки
		|		ПО ВТ_Номенклатура.Номенклатура = ОстаткиНоменклатурыОстатки.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура
		|ИТОГИ ПО
		|	Номенклатура ТОЛЬКО ИЕРАРХИЯ";
	
	ДеревоЗначений = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);    
    ЗначениеВРеквизитФормы(ДеревоЗначений, "СписокНоменклатуры");
	
	ЭлементыУдаления = Новый Массив;
	
	КоличествоВложенныхЭлементов = РекурсивнаяКорректировкаНаименований(СписокНоменклатуры.ПолучитьЭлементы(), ЭлементыУдаления);
	
	Для Каждого ИдентификаторСтроки Из ЭлементыУдаления Цикл	
		Если НЕ ИдентификаторСтроки = Неопределено Тогда		
			ТекущаяСтрока       = СписокНоменклатуры.НайтиПоИдентификатору(ИдентификаторСтроки.ПолучитьИдентификатор());
			СтрокаРодитель      = ТекущаяСтрока.ПолучитьРодителя();	
			Если СтрокаРодитель = Неопределено Тогда
				СписокНоменклатуры.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
			Иначе
				СтрокаРодитель.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
	//--
	ЭлементыУдаления = Новый Массив;
	
	КоличествоВложенныхЭлементов = РекурсивнаяКорректировкаНаименований(СписокНоменклатуры.ПолучитьЭлементы(), ЭлементыУдаления);
	
	Для Каждого ИдентификаторСтроки Из ЭлементыУдаления Цикл	
		Если НЕ ИдентификаторСтроки = Неопределено Тогда		
			ТекущаяСтрока       = СписокНоменклатуры.НайтиПоИдентификатору(ИдентификаторСтроки.ПолучитьИдентификатор());
			СтрокаРодитель      = ТекущаяСтрока.ПолучитьРодителя();	
			Если СтрокаРодитель = Неопределено Тогда
				СписокНоменклатуры.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
			Иначе
				СтрокаРодитель.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
КонецФункции

