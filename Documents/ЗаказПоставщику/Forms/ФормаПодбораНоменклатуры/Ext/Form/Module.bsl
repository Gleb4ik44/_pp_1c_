&НаСервере
Функция РекурсивнаяКорректировкаНаименований(ЭлементыДерева, ЭлементыУдаления)

	КоличествоЭлементов = 0;
	
	Для каждого Элем Из ЭлементыДерева Цикл
		
		КоличествоЭлементов = КоличествоЭлементов + 1;
		
		Если НЕ ЗначениеЗаполнено(Элем.Номенклатура) Тогда
			Элем.Номенклатура = "Без группы";
			Элем.ЭтоГруппа = Истина;
		КонецЕсли;
		
		Если Элем.ЭтоГруппа Тогда
			Элем.Картинка = БиблиотекаКартинок.Папка;
		ИначеЕсли Элем.ПометкаУдаления Тогда
			Элем.Картинка = БиблиотекаКартинок.КодМаркировкиОтсутствуетГосИС;	
		Иначе
			Элем.Картинка = БиблиотекаКартинок.МетаданныеРеквизиты;	
		КонецЕсли;
		
		КоличествоЭлементовВложеных = РекурсивнаяКорректировкаНаименований(Элем.ПолучитьЭлементы(), ЭлементыУдаления); 
		
		Если Элем.ЭтоГруппа И КоличествоЭлементовВложеных = 0 Тогда
			ЭлементыУдаления.Добавить(Элем);	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КоличествоЭлементов;
	
КонецФункции

